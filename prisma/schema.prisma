generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AttemptStatus {
  STARTED
  COMPLETED
  EXPIRED
  REJECTED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LedgerType {
  TASK_REWARD
  WITHDRAWAL_RESERVE
  WITHDRAWAL_REFUND
  ADMIN_ADJUSTMENT
}

model User {
  id            String         @id @default(cuid())
  telegramId    String         @unique
  username      String?
  firstName     String?
  lastName      String?
  phoneHash     String?
  balance       Decimal        @default(0) @db.Decimal(18, 2)
  blockedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  attempts      Attempt[]
  ledgerEntries LedgerEntry[]
  withdrawals   Withdrawal[]

  @@index([createdAt])
}

model Task {
  id             String      @id @default(cuid())
  title          String
  description    String?
  destinationUrl String
  provider       String
  reward         Decimal     @db.Decimal(18, 2)
  status         TaskStatus  @default(ACTIVE)
  minDurationSec Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  attempts       Attempt[]

  @@index([status, createdAt])
}

model Attempt {
  id          String        @id @default(cuid())
  tokenHash   String        @unique
  userId      String
  taskId      String
  status      AttemptStatus @default(STARTED)
  startedAt   DateTime      @default(now())
  expiresAt   DateTime
  completedAt DateTime?
  goIp        String?
  callbackIp  String?
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  task        Task          @relation(fields: [taskId], references: [id], onDelete: Restrict)
  ledgerEntry LedgerEntry?

  @@index([userId, taskId, startedAt])
  @@index([status, expiresAt])
}

model LedgerEntry {
  id           String      @id @default(cuid())
  userId       String
  type         LedgerType
  amount       Decimal     @db.Decimal(18, 2)
  balanceAfter Decimal     @db.Decimal(18, 2)
  attemptId    String?     @unique
  withdrawalId String?     @unique
  note         String?
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  attempt      Attempt?    @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  withdrawal   Withdrawal? @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

model Withdrawal {
  id            String           @id @default(cuid())
  userId        String
  amount        Decimal          @db.Decimal(18, 2)
  status        WithdrawalStatus @default(PENDING)
  payoutDetails Json
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerEntry   LedgerEntry?

  @@index([status, createdAt])
  @@index([userId, status])
}

model BlocklistEntry {
  id        String   @id @default(cuid())
  phoneHash String   @unique
  reason    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  subjectId String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([subjectId, createdAt])
}
